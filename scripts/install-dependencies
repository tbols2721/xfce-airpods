#!/usr/bin/env bash
set -euo pipefail

# Keep the existing audio server; this list installs no PipeWire replacement.
packages=(
    build-essential cmake ninja-build pkgconf
    qt6-base-dev qt6-declarative-dev qt6-connectivity-dev qt6-tools-dev
    qt6-l10n-tools libssl-dev libpulse-dev
    qml6-module-qtquick qml6-module-qtquick-controls
    qml6-module-qtquick-templates qml6-module-qtquick-layouts
    qml6-module-qtquick-window qml6-module-qtqml-workerscript
    python3-gi python3-dbus gir1.2-gtk-3.0 xfce4-genmon-plugin
    bluez pulseaudio-utils blueman pavucontrol patch
)

sudo apt-get update
sudo apt-get install --no-install-recommends --no-remove "${packages[@]}"
printf '\nAirPods build dependencies are installed. You can close this terminal.\n'
